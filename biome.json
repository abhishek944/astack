{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "preset": "none"
      },
      "correctness": {
        "noUnusedVariables": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "formatter": {
    "enabled": false
  },
  "files": {
    "includes": [
      "src/**/*.ts"
    ]
  }
}
