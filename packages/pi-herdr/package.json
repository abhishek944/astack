{
  "name": "@abhishek944/pi-herdr",
  "version": "0.1.0",
  "description": "Herdr Core agent lifecycle tools and coordination skill for Pi.",
  "license": "MIT AND Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "herdr",
    "agents"
  ],
  "files": [
    "dist/",
    "skills/herdr/",
    "third_party/licenses/herdr-Apache-2.0.txt",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "./skills"
    ]
  }
}
