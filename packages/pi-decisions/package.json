{
  "name": "@abhishek944/pi-decisions",
  "version": "0.1.0",
  "description": "Browser questions and visual comparisons with local or here.now delivery for Pi.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "decisions"
  ],
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "bin": {
    "pi-decisions": "./dist/cli.js"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "@biomejs/biome": "^2.6.4"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
