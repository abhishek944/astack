{
  "name": "@abhishek944/pi-schedulers",
  "version": "0.1.0",
  "description": "Scheduled prompt runs for Pi, presented and hosted by the Herdr desktop app.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "scheduler",
    "scheduled-tasks",
    "herdr"
  ],
  "files": [
    "dist/",
    "bin/",
    "herdr/",
    "!herdr/**/*.d.ts",
    "!herdr/**/jsconfig.json",
    "docs/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "pi-schedulers": "./bin/pi-schedulers.js"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc && node scripts/build-mod-core.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --fix src/",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^26.1.2",
    "typebox": "1.3.27",
    "typescript": "^7.0.2"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
