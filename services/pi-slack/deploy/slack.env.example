# Copy to ~/.config/pi-slack/slack.env, replace both placeholder values with
# the real Slack tokens, then restrict the file: chmod 600 <file>.
# This file is private service configuration. Never commit it or pass tokens on
# the command line.
SLACK_BOT_TOKEN=xoxb-replace-with-bot-token
SLACK_APP_TOKEN=xapp-replace-with-app-token
