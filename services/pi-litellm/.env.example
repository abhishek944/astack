# Nonsecret reference only. Do not copy to .env or source this file.
# Configure these names in Doppler project effect-boilerplate, config dev.
# Start using the README's Doppler allowlist and Compose --env-file /dev/null.
# Preserve existing values during migration; never regenerate credentials here.

# Server-only proxy admin credential; clients use their own virtual keys.
LITELLM_MASTER_KEY=CHANGE_ME
# Encryption salt: changing it breaks access to stored provider credentials.
LITELLM_SALT_KEY=CHANGE_ME
# Existing bootstrap UI login.
LITELLM_UI_USERNAME=CHANGE_ME
LITELLM_UI_PASSWORD=CHANGE_ME
# Existing URL-safe DB password. Compose maps this to POSTGRES_PASSWORD.
LITELLM_POSTGRES_PASSWORD=CHANGE_ME
# OpenAI provider credential; models reference os.environ/OPENAI_API_KEY.
OPENAI_API_KEY=CHANGE_ME

# LITELLM_PORT is an optional nonsecret shell override, default 4000.
# New provider env names require an explicit Compose environment entry and an
# addition to the Doppler --only-secrets allowlist. No entire-env forwarding.
# Client LITELLM_API_KEY is not a service input and is never the master key.
